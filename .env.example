# Docker Compose 对外发布的宿主机端口
FLUXGATE_HOST_PORT=8081

# 宿主机上存放 hub.db 数据库的数据目录（挂载到容器 /data）
# 目录属主由镜像入口脚本在启动时自动修正为容器用户（UID/GID 10001），
# 无需手动 chown；仅 SELinux 环境可能还需在 compose 中为挂载启用 selinux: z
FLUXGATE_DATA_DIR=./data

# 管理端点/控制台的访问令牌：供脚本和自动化调用管理接口使用。
# 生成方式：openssl rand -hex 32。
# 控制台登录使用管理员账号（见下方 FLUXGATE_ADMIN_*）；
# 该令牌不再是登录控制台的凭据，也不受“必须改密”限制，留空即只接受账号会话。
FLUXGATE_MANAGEMENT_TOKEN=

# 控制台管理员账号的初始密码。
# 留空时：网关首次启动会自动创建 admin/admin，并强制首次登录后修改密码
# （改密之前不返回任何网关数据），因此保持留空也是安全的默认行为。
# 填写的值会替代默认密码，且同样标记为必须修改。
# 仅用于首次创建；账号已存在时此变量不再起作用，可安全移除。
# 若不想把密码写进 .env，可留空，改在宿主机上执行一次：
#   docker compose exec gateway /app/fluxgate admin reset
FLUXGATE_ADMIN_PASSWORD=
# 管理员账号用户名，默认 admin
FLUXGATE_ADMIN_USERNAME=admin

# 启动时对共享 SQLite 数据库做完整性检查，发现损坏即拒绝启动。
# 前提：网关必须是该数据库唯一的写入进程
FLUXGATE_INTEGRITY_CHECK=true

# 请求限制与各类超时
FLUXGATE_MAX_BODY_BYTES=8388608
FLUXGATE_REQUEST_TIMEOUT=60s
FLUXGATE_CONNECT_TIMEOUT=10s
FLUXGATE_TLS_HANDSHAKE_TIMEOUT=10s
FLUXGATE_RESPONSE_HEADER_TIMEOUT=30s
FLUXGATE_IDLE_CONN_TIMEOUT=90s
FLUXGATE_READ_HEADER_TIMEOUT=10s
FLUXGATE_READ_TIMEOUT=30s
FLUXGATE_WRITE_TIMEOUT=0s
FLUXGATE_IDLE_TIMEOUT=120s
FLUXGATE_SHUTDOWN_TIMEOUT=15s

# 重试与故障转移策略
# 这些值都是进程默认值：管理台「设置」页写入的覆盖项优先，清空覆盖项后又回到这里。
FLUXGATE_MAX_ATTEMPTS=8
FLUXGATE_MAX_ATTEMPTS_PER_CHANNEL=2
FLUXGATE_RETRY_BASE_BACKOFF=50ms
FLUXGATE_RETRY_MAX_BACKOFF=1s
# 关闭后失败的请求只在同一条线路上重试，不会切到别的线路
FLUXGATE_FAILOVER_ENABLED=true
# 关闭后只会在同一个上游的不同密钥之间切换，不会换到其它上游
FLUXGATE_FAILOVER_CROSS_UPSTREAM=true

# 熔断器策略
FLUXGATE_BREAKER_MODE=cooldown
FLUXGATE_BREAKER_THRESHOLD=3
FLUXGATE_BREAKER_BASE_COOLDOWN=30s
FLUXGATE_BREAKER_MAX_COOLDOWN=15m
# 每多熔断一次，冷却时间乘以此倍数，直到上限
FLUXGATE_BREAKER_COOLDOWN_MULTIPLIER=2

# 请求记录：网关服务过的每个请求都会记一条，管理台「请求记录」页读的就是它。
# 客户端只拿到状态码和错误码，上游返回的原文只在这里，所以排查报错靠它。
FLUXGATE_REQUEST_LOG_ENABLED=true
# 只保留最近的这么多条，更早的记录在写入新记录时被删除
FLUXGATE_REQUEST_LOG_KEEP=1000

# 可选的出站代理配置（部分上游站点需要走代理时填写）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
