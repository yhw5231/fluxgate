# Host port published by Docker Compose
FLUXGATE_HOST_PORT=8081

# Host directory containing the existing hub.db file
FLUXGATE_DATA_DIR=./data

# Set a strong token before enabling management endpoints
FLUXGATE_MANAGEMENT_TOKEN=change-me

# Request limits and timeouts
FLUXGATE_MAX_BODY_BYTES=8388608
FLUXGATE_REQUEST_TIMEOUT=60s
FLUXGATE_CONNECT_TIMEOUT=10s
FLUXGATE_TLS_HANDSHAKE_TIMEOUT=10s
FLUXGATE_RESPONSE_HEADER_TIMEOUT=30s
FLUXGATE_IDLE_CONN_TIMEOUT=90s
FLUXGATE_READ_HEADER_TIMEOUT=10s
FLUXGATE_READ_TIMEOUT=30s
FLUXGATE_WRITE_TIMEOUT=0s
FLUXGATE_IDLE_TIMEOUT=120s
FLUXGATE_SHUTDOWN_TIMEOUT=15s

# Retry policy
FLUXGATE_MAX_ATTEMPTS=8
FLUXGATE_MAX_ATTEMPTS_PER_CHANNEL=2
FLUXGATE_RETRY_BASE_BACKOFF=50ms
FLUXGATE_RETRY_MAX_BACKOFF=1s

# Circuit-breaker policy
FLUXGATE_BREAKER_MODE=cooldown
FLUXGATE_BREAKER_THRESHOLD=3
FLUXGATE_BREAKER_BASE_COOLDOWN=30s
FLUXGATE_BREAKER_MAX_COOLDOWN=15m

# Optional outbound proxy configuration
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
