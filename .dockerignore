# .git is deliberately not ignored: the builder reads it to stamp the binary with
# the revision it was built from, which is what the console shows next to the
# uptime. Ignored, that binary can only report "unknown".
.gitignore
.github

# Documentation and editor metadata
README.md
.idea
.vscode
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
.env.*
*.pem
*.key

# Build, test, and coverage artifacts
bin
build
dist
coverage
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
fluxgate
fluxgate.exe

# Runtime data must be mounted, not baked into the image
data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Temporary files
*.log
tmp
temp
.cache
